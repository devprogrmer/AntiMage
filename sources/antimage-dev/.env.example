# Public gateway/listener.
# The Go gateway intentionally uses the historical UVICORN_* names.
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# ANTIMAGE_GATEWAY_ADDR = ":8000"

# Gateway TLS.
# UVICORN_SSL_CERTFILE = "/var/lib/antimage/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/antimage/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# Database.
# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"

# Binary/install metadata.
# ANTIMAGE_INSTALL_MODE = "binary"
# ANTIMAGE_SCRIPT_BIN = "/usr/local/bin/antimage"
# ANTIMAGE_APP_DIR = "/opt/antimage"
# ANTIMAGE_DATA_DIR = "/var/lib/antimage"
# ANTIMAGE_SERVICE_NAME = "antimage"

# Initial admin bootstrap.

# Node operations and user lifecycle jobs.
# ANTIMAGE_NODE_OPERATIONS_POLL_INTERVAL = "15s"
# ANTIMAGE_NODE_USAGE_COLLECTION_INTERVAL = "30s"
# ANTIMAGE_NODE_USAGE_COLLECTION_LIMIT = 0
# ANTIMAGE_USER_LIFECYCLE_INTERVAL = "10s"
# ANTIMAGE_USER_LIFECYCLE_BATCH_SIZE = 500
# ANTIMAGE_USER_USAGE_RESET_INTERVAL = "1h"
# ANTIMAGE_USER_USAGE_RESET_BATCH_SIZE = 500
# ANTIMAGE_USER_AUTODELETE_INTERVAL = "1h"
# ANTIMAGE_USER_AUTODELETE_BATCH_SIZE = 500
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

# API behavior.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# USERS_LIST_TIMEOUT_SECONDS = 0

# Settings, templates, certificates, and backup roots.
# ANTIMAGE_CERT_BASE = "/var/lib/antimage/certs"
# ANTIMAGE_CONFIG_DIR = "/etc/antimage"
