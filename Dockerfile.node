FROM golang:1.25-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/antimage-node ./cmd/antimage_node

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/antimage-node
COPY --from=builder /out/antimage-node /usr/local/bin/antimage-node

ENV ANTIMAGE_NODE_INSTALL_MODE=docker \
    ANTIMAGE_NODE_UPDATE_CHANNEL=stable \
    ANTIMAGE_NODE_DATA_DIR=/var/lib/antimage-node \
    ANTIMAGE_DATA_DIR=/var/lib/antimage-node \
    SSL_CERT_FILE=/var/lib/antimage-node/cert.pem \
    SSL_KEY_FILE=/var/lib/antimage-node/cert.key \
    XRAY_EXECUTABLE_PATH=/var/lib/antimage-node/xray-core/xray \
    XRAY_ASSETS_PATH=/var/lib/antimage-node/xray-core \
    SERVICE_HOST=0.0.0.0 \
    SERVICE_PORT=62050 \
    XRAY_API_HOST=127.0.0.1 \
    XRAY_API_PORT=62051

VOLUME ["/var/lib/antimage-node"]
EXPOSE 62050
ENTRYPOINT ["antimage-node"]
